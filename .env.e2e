# Env file for the dedicated e2e docker-compose project (see scripts/e2e-stack.sh).
# Every host port here is your normal dev port + 10000, so the two stacks can run
# side by side without colliding -- this project never touches your dev Postgres/Kafka.
# Everything not listed (DB users/passwords, JWT_SECRET, Kafka topic names) intentionally
# stays at docker-compose.yml's defaults: those are internal-network-scoped or must match
# kong/kong.yml's static JWT consumer secret, and don't need to differ between the two stacks.

USER_DB_HOST_PORT=15433
ANALYTICS_DB_HOST_PORT=15434
EVENT_DB_HOST_PORT=15435
BOOKING_DB_HOST_PORT=15436

USER_SERVICE_HOST_PORT=18081
ANALYTICS_SERVICE_HOST_PORT=18084
EVENT_SERVICE_HOST_PORT=18082
BOOKING_SERVICE_HOST_PORT=18085

KAFKA_CONNECT_HOST_PORT=18083
KAFKA_EXTERNAL_HOST_PORT=19094

KONG_PROXY_HOST_PORT=18000
KONG_ADMIN_HOST_PORT=18001
