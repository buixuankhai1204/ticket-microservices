{
  "consumer": {
    "name": "analytics-service"
  },
  "interactions": [
    {
      "contents": {
        "content": {
          "created_at": "2000-02-01T12:30:00Z",
          "email": "ada@example.com",
          "event_id": "fc763eba-0905-41c5-a27f-3934ab26786c",
          "user_id": "fc763eba-0905-41c5-a27f-3934ab26786c"
        },
        "contentType": "application/json",
        "encoded": false
      },
      "description": "a UserCreated event",
      "matchingRules": {
        "body": {
          "$.created_at": {
            "combine": "AND",
            "matchers": [
              {
                "match": "regex",
                "regex": "^([\\+-]?\\d{4}(?!\\d{2}\\b))((-?)((0[1-9]|1[0-2])(\\3([12]\\d|0[1-9]|3[01]))?|W([0-4]\\d|5[0-2])(-?[1-7])?|(00[1-9]|0[1-9]\\d|[12]\\d{2}|3([0-5]\\d|6[1-6])))([T\\s]((([01]\\d|2[0-3])((:?)[0-5]\\d)?|24\\:?00)([\\.,]\\d+(?!:))?)?(\\17[0-5]\\d([\\.,]\\d+)?)?([zZ]|([\\+-])([01]\\d|2[0-3]):?([0-5]\\d)?)?)?)?$"
              }
            ]
          },
          "$.email": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          },
          "$.event_id": {
            "combine": "AND",
            "matchers": [
              {
                "match": "regex",
                "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
              }
            ]
          },
          "$.user_id": {
            "combine": "AND",
            "matchers": [
              {
                "match": "regex",
                "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
              }
            ]
          }
        }
      },
      "metadata": {
        "contentType": "application/json",
        "event_type": "UserCreated",
        "topic": "user.events"
      },
      "pending": false,
      "providerStates": [
        {
          "name": "a user has just registered"
        }
      ],
      "type": "Asynchronous/Messages"
    },
    {
      "contents": {
        "content": {
          "email": "ada@example.com",
          "event_id": "fc763eba-0905-41c5-a27f-3934ab26786c",
          "logged_in_at": "2000-02-01T12:30:00Z",
          "user_id": "fc763eba-0905-41c5-a27f-3934ab26786c"
        },
        "contentType": "application/json",
        "encoded": false
      },
      "description": "a UserLoggedIn event",
      "matchingRules": {
        "body": {
          "$.email": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          },
          "$.event_id": {
            "combine": "AND",
            "matchers": [
              {
                "match": "regex",
                "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
              }
            ]
          },
          "$.logged_in_at": {
            "combine": "AND",
            "matchers": [
              {
                "match": "regex",
                "regex": "^([\\+-]?\\d{4}(?!\\d{2}\\b))((-?)((0[1-9]|1[0-2])(\\3([12]\\d|0[1-9]|3[01]))?|W([0-4]\\d|5[0-2])(-?[1-7])?|(00[1-9]|0[1-9]\\d|[12]\\d{2}|3([0-5]\\d|6[1-6])))([T\\s]((([01]\\d|2[0-3])((:?)[0-5]\\d)?|24\\:?00)([\\.,]\\d+(?!:))?)?(\\17[0-5]\\d([\\.,]\\d+)?)?([zZ]|([\\+-])([01]\\d|2[0-3]):?([0-5]\\d)?)?)?)?$"
              }
            ]
          },
          "$.user_id": {
            "combine": "AND",
            "matchers": [
              {
                "match": "regex",
                "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
              }
            ]
          }
        }
      },
      "metadata": {
        "contentType": "application/json",
        "event_type": "UserLoggedIn",
        "topic": "user.events"
      },
      "pending": false,
      "providerStates": [
        {
          "name": "a user has just logged in"
        }
      ],
      "type": "Asynchronous/Messages"
    }
  ],
  "metadata": {
    "pact-go": {
      "version": "2.8.0"
    },
    "pactRust": {
      "ffi": "0.5.8",
      "models": "1.3.16"
    },
    "pactSpecification": {
      "version": "4.0"
    }
  },
  "provider": {
    "name": "user-service"
  }
}