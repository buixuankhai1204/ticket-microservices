        "contentType": "application/json",
        "encoded": false
      },
      "description": "a BookingCancelled event",
      "matchingRules": {
        "body": {
          "$.booking_id": {
            "combine": "AND",
            "matchers": [
              {
                "match": "regex",
                "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
              }
            ]
          },
          "$.event_id": {
            "combine": "AND",
