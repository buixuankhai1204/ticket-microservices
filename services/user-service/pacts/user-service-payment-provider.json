          "Idempotency-Key": [
            "renew:3f2b8c1e-5a47-4d0e-9a52-1c6f0e7d2b90:2031-03-31"
          ]
        },
        "matchingRules": {
          "header": {
            "Idempotency-Key": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^renew:[0-9a-f-]{36}:[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/v1/charges"
      },
