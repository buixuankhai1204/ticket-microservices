      "description": "a charge for a card that is declined with card_declined",
      "pending": false,
      "providerStates": [
        {
          "name": "the payment method pm_card_chargeDeclined is declined with card_declined"
        }
      ],
      "request": {
        "body": {
          "content": {
            "amount_minor": 1999,
            "currency": "USD",
            "payment_method_id": "pm_card_chargeDeclined"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Authorization": [
            "Bearer test-key"
