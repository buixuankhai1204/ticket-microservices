{
  "title": "Service RED Metrics",
  "uid": "service-red-metrics",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "tags": ["red", "ticket-microservice"],
  "templating": {
    "list": [
      {
        "name": "job",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(http_requests_total, job)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Request rate (per route)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (job, path) (rate(http_requests_total{job=~\"$job\"}[5m]))",
          "legendFormat": "{{job}} {{path}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Error rate % (5xx, per route)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "100 * sum by (job, path) (rate(http_requests_total{job=~\"$job\", status=~\"5..\"}[5m])) / sum by (job, path) (rate(http_requests_total{job=~\"$job\"}[5m]))",
          "legendFormat": "{{job}} {{path}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Latency p50 / p95 / p99 (per route)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 5 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, job, path) (rate(http_requests_duration_seconds_bucket{job=~\"$job\"}[5m])))",
          "legendFormat": "p50 {{job}} {{path}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, job, path) (rate(http_requests_duration_seconds_bucket{job=~\"$job\"}[5m])))",
          "legendFormat": "p95 {{job}} {{path}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, job, path) (rate(http_requests_duration_seconds_bucket{job=~\"$job\"}[5m])))",
          "legendFormat": "p99 {{job}} {{path}}",
          "refId": "C"
        }
      ]
    },
    {
      "id": 4,
      "title": "Status code breakdown (per route)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 25 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10, "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (job, path, status) (rate(http_requests_total{job=~\"$job\"}[5m]))",
          "legendFormat": "{{job}} {{path}} {{status}}",
          "refId": "A"
        }
      ]
    }
  ]
}
