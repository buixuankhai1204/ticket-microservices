# Copy to .env and adjust for local development.
# docker-compose reads these automatically; user-service also reads
# DATABASE_URL/JWT_SECRET/DB_MAX_CONNECTIONS/PORT directly when run outside Docker.

USER_DB_USER=user_service
USER_DB_PASSWORD=user_service
USER_DB_NAME=user_service
USER_DB_MAX_CONNECTIONS=10

ANALYTICS_DB_USER=analytics_service
ANALYTICS_DB_PASSWORD=analytics_service
ANALYTICS_DB_NAME=analytics_service
ANALYTICS_DB_MAX_CONNS=20

EVENT_DB_USER=event_service
EVENT_DB_PASSWORD=event_service
EVENT_DB_NAME=event_service
EVENT_DB_MAX_CONNS=20

# Symmetric key used to sign JWTs issued by user-service. Must match the `secret`
# on the matching consumer's jwt_secrets entry in kong/kong.yml, or Kong will
# reject every token on JWT-protected routes. Generate a real secret for
# anything beyond local dev, e.g.: openssl rand -base64 32
JWT_SECRET=dev-secret-change-me

# Must match that same consumer's jwt_secrets `key` in kong/kong.yml — Kong picks
# the verification secret by looking up this claim, not by user identity.
JWT_ISSUER=user-service

# Kafka (choreography saga bus). In docker-compose every service talks to the
# in-network broker at kafka:9092; override only if pointing at an external one.
#
# The publish side is CDC: a Debezium PostgreSQL connector on Kafka Connect
# (the `kafka-connect` service; connector def in debezium/user-service-outbox.json,
# registered by `connect-init`) tails user_service's outbox_events WAL and routes
# each event to `<aggregate_type>.events` via the Outbox Event Router SMT. This
# needs wal_level=logical on postgres-user (set via its `command:` in compose).
#
# UserCreated (aggregate_type "user") therefore lands on `user.events`; kafka-init
# also creates "<topic>.dlq". This name is only consumed by analytics-service now.
KAFKA_USER_EVENTS_TOPIC=user.events
# How many times analytics-service retries a transient failure before
# dead-lettering a UserCreated message.
KAFKA_CONSUMER_MAX_ATTEMPTS=5
